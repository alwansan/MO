<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility is limited to the game packages we explicitly inspect. -->
    <queries>
        <package android:name="com.tencent.mhadv" />
        <package android:name="com.garena.game.mho" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.imobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_mo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MO">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Official Shizuku provider (binder acquisition only, no su/root). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
